<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_survey_user_input_form_inherit_payments" model="ir.ui.view">
        <field name="name">survey.user_input.form.inherit.payments</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Payments" name="page_payments">

                    <group string="Payments" colspan="4" name="group_payments">
                        <field
                            name="payment_ids"
                            nolabel="1"
                            colspan="2"
                            context="{ 'default_payment_type': 'outbound', 'default_partner_id': partner_id}"
                        >
                            <tree>
                                <field name="name" />
                                <field name="date" />
                                <field name="amount" sum="Total" />
                                <field name="currency_id" />
                                <field name="state" />
                            </tree>
                        </field>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
