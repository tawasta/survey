<odoo>
    <record id="survey_user_input_view_form" model="ir.ui.view">
        <field name="name">survey.user_input.form.inherit.parent.child.link</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form" />
        <field name="arch" type="xml">

            <field name="user_input_line_ids" position="after">
                <separator
                    string="Follow-up Answers"
                    name="separator_followup_answers"
                    invisible="not child_survey_user_input_ids"
                />
                <field
                    name="child_survey_user_input_line_ids"
                    mode="tree"
                    readonly="True"
                    no_label="1"
                    invisible="not child_survey_user_input_ids"
                >
                    <tree child_survey_user_input_line_ids-muted="skipped == True">
                        <field name="question_sequence" column_invisible="True" />
                        <field name="create_date" optional="hidden" />
                        <field name="page_id" optional="hidden" />
                        <field name="question_id" />
                        <field name="answer_type" optional="hidden" />
                        <field name="skipped" hide="1" />
                        <field name="display_name" string="Answer" />
                        <field name="answer_is_correct" />
                        <field name="answer_score" sum="Score" />
                    </tree>
                </field>

                <group name="group_techical_user_input_link_fields" col="4">
                    <field
                        name="parent_survey_user_input_id"
                        options="{ 'no_create': 1}"
                    />
                    <field
                        name="child_survey_user_input_ids"
                        options="{ 'no_create': 1}"
                        colspan="3"
                    >
                        <tree>
                            <field name="ref" />
                            <field name="survey_id" optional="show" />
                            <field name="create_date" optional="show" />
                            <field name="stage_id" optional="show" />
                        </tree>
                    </field>
                </group>
            </field>
        </field>
    </record>
</odoo>
