#. module: survey_question_show_only_for_specific_event_ticket
#: model:ir.model,name:survey_question_show_only_for_specific_event_ticket.model_event_event_ticket
msgid "Event Ticket"
msgstr "Tapahtuman lippu"

#. module: survey_question_show_only_for_specific_event_ticket
#: model:ir.model.fields,help:survey_question_show_only_for_specific_event_ticket.field_survey_question__event_ticket_ids
msgid ""
"If set, this question is only shown on event questionnaires if the event "
"registrant is buying one of these tickets"
msgstr ""
"Jos asetettu, kysymys näytetään tapahtuman kyselylomakkeella vain, jos tapahtuman osallistuja "
"on ostamassa jotain näistä lipuista."

#. module: survey_question_show_only_for_specific_event_ticket
#: model:ir.model.fields,field_description:survey_question_show_only_for_specific_event_ticket.field_event_event_ticket__survey_question_ids
msgid "Questions Specific to this Event Ticket"
msgstr "Tätä tapahtumalippua koskevat kysymykset"

#. module: survey_question_show_only_for_specific_event_ticket
#: model:ir.model.fields,help:survey_question_show_only_for_specific_event_ticket.field_event_event_ticket__survey_question_ids
msgid ""
"Questions that have been configured to be asked when event registrant is "
"buying this ticket"
msgstr ""
"Kysymykset, jotka on asetettu näkymään, kun tapahtumaosallistuja on ostamassa tätä lippua. "

#. module: survey_question_show_only_for_specific_event_ticket
#: model:ir.model.fields,field_description:survey_question_show_only_for_specific_event_ticket.field_survey_question__event_ticket_ids
msgid "Show only for Specific Event Tickets"
msgstr ""
"Näytä vain tietyille tapahtumalipuille"

#. module: survey_question_show_only_for_specific_event_ticket
#: model:ir.model,name:survey_question_show_only_for_specific_event_ticket.model_survey_question
msgid "Survey Question"
msgstr "Kyselyn kysymykset"
