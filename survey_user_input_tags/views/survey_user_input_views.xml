<odoo>
    <record id="survey_user_input_view_form_inherit" model="ir.ui.view">
        <field name="name">survey.user_input.form.inherit.tags</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form" />
        <field name="arch" type="xml">
            <field name="create_date" position="after">
              <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                />
            </field>
        </field>
    </record>

    <record id="survey_user_input_view_tree_inherit" model="ir.ui.view">
        <field name="name">survey.user_input.tree.inherit.tags</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_tree" />
        <field name="arch" type="xml">
            <field name="state" position="before">
              <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color'}"
                    optional="hide"
                />
            </field>
        </field>
    </record>

</odoo>
