<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_purge_expired_survey_answers" model="ir.cron">
        <field name="name">Survey: purge expired answer data</field>
        <field name="model_id" ref="survey.model_survey_question" />
        <field name="state">code</field>
        <field name="code">model._cron_purge_expired_answers()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number" eval="1" />
        <field name="interval_type">days</field>
        <field name="numbercall" eval="-1" />
        <field name="priority" eval="5" />
        <field name="doall" eval="0" />
        <field name="active" eval="0" />
    </record>
</odoo>
