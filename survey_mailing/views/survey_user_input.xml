<odoo>
    <record id="survey_user_input_form_inherit_mail" model="ir.ui.view">
        <field name="name">survey.user_input.form.inherit.mail</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <button
                    name="action_survey_user_input_email_send"
                    string="Send E-mail"
                    class="btn-primary o_stat_btn"
                    type="object"
                    icon="fa-envelope"
                />
            </header>
        </field>
    </record>

    <record
        id="ir_actions_server_survey_user_input_send_email"
        model="ir.actions.server"
    >
        <field name="name">Send E-mail</field>
        <field name="model_id" ref="survey.model_survey_user_input" />
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_survey_user_input_email_send()
        </field>
        <field name="binding_model_id" ref="survey.model_survey_user_input" />
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
