<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template
        id="question_container_model_select"
        inherit_id="survey.question_container"
    >
        <xpath expr="//t[@t-call='survey.question_matrix']//.." position="after">
            <t t-if="question.question_type == 'model_select'">
                <t t-call="survey_question_model_select.question_model_select" />
            </t>
        </xpath>
    </template>

    <template id="survey_page_print_model_select" inherit_id="survey.survey_page_print">
        <xpath expr="//div[hasclass('o_survey_question_error')]" position="before">
            <t t-if="question.question_type == 'model_select'">
                <t t-call="survey_question_model_select.review_model_select" />
            </t>
        </xpath>
    </template>

    <template id="question_model_select" name="Question: Odoo Model Dropdown">
        <div class="o_survey_model_select_container">
            <t
                t-set="answer_line"
                t-value="answer_lines.filtered(lambda line: line.answer_type == 'suggestion' and line.suggested_answer_id.question_id == question)"
            />
            <t
                t-set="selected_answer_id"
                t-value="answer_line and answer_line[0].suggested_answer_id.id or False"
            />

            <select
                class="form-select o_survey_question_model_select"
                t-att-name="question.id"
                t-att-data-name="question.id"
                t-att-data-question-type="question.question_type"
            >
                <option value="">Select...</option>

                <t t-foreach="question.suggested_answer_ids" t-as="answer">
                    <option
                        t-att-value="answer.id"
                        t-att-selected="'selected' if selected_answer_id == answer.id else None"
                    >
                        <t t-esc="answer.value" />
                    </option>
                </t>
            </select>
        </div>
    </template>

    <template id="review_model_select" name="Review: Odoo Model Dropdown">
        <div class="o_survey_model_select_answer">
            <t t-foreach="answer_lines" t-as="line">
                <t
                    t-if="line.answer_type == 'suggestion' and line.suggested_answer_id.question_id.question_type == 'model_select'"
                >
                    <div class="border rounded p-2">
                        <t t-esc="line.suggested_answer_id.value" />
                    </div>
                </t>
            </t>
        </div>
    </template>

</odoo>
