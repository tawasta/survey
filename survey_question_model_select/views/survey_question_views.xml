<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="survey_question_form_model_select">
        <field name="name">survey.question.form.model.select</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form" />
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('o_preview_questions')]" position="inside">
                <div
                    invisible="question_type != 'model_select'"
                    role="img"
                    aria-label="Odoo model dropdown"
                    title="Odoo model dropdown"
                >
                    <span>Choose from Odoo records</span><br />
                    <i class="fa fa-list fa-4x" />
                </div>
            </xpath>

            <xpath expr="//page[@name='answers']" position="inside">

                <div
                    invisible="question_type != 'model_select'"
                    class="text-muted mb-3"
                >
                    Select a source model, optionally filter its records, then generate
                    the dropdown values below.
                </div>

                <group
                    invisible="question_type != 'model_select'"
                    string="Data Source"
                >
                    <group>
                        <field
                            name="model_select_model_id"
                            required="question_type == 'model_select'"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field name="model_select_model" invisible="1" />
                    </group>
                    <group>
                        <field name="model_select_limit" />
                    </group>
                </group>

                <separator
                    string="Record Filter"
                    invisible="question_type != 'model_select'"
                />

                <div
                    invisible="question_type != 'model_select'"
                    class="mb-3"
                >
                    <field
                        name="model_select_domain"
                        widget="domain"
                        options="{'model': 'model_select_model'}"
                        nolabel="1"
                    />

                    <div class="d-flex justify-content-end align-items-center mt-2">
                        <button
                            name="action_refresh_model_select_answers"
                            type="object"
                            string="Update Dropdown Values"
                            icon="fa-refresh"
                            class="btn-secondary"
                            invisible="not model_select_model_id"
                            help="Generate dropdown values from the selected model and filter."
                        />
                    </div>
                </div>

                <separator
                    string="Dropdown Values"
                    invisible="question_type != 'model_select'"
                />

                <div
                    invisible="question_type != 'model_select'"
                    class="text-muted mb-2"
                >
                    These are the choices shown in the survey dropdown. Remove rows that
                    should not be available.
                </div>

                <field
                    name="suggested_answer_ids"
                    invisible="question_type != 'model_select'"
                    nolabel="1"
                    context="{'default_question_id': id}"
                >
                    <tree editable="bottom" default_order="sequence, id">
                        <field name="sequence" widget="handle" />
                        <field name="value" string="Dropdown Value" />
                        <field
                            name="model_select_res_model"
                            string="Source Model"
                            readonly="1"
                            optional="hide"
                        />
                        <field
                            name="model_select_res_id"
                            string="Source ID"
                            readonly="1"
                            optional="hide"
                        />
                    </tree>
                </field>

            </xpath>

        </field>
    </record>
</odoo>