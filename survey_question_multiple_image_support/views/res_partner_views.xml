<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_partner_form_inherit_survey_lang" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.survey.lang</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[field[@name='email']]" position="after">
                <field
                    name="survey_lang_id"
                    options="{'no_create': True}"
                    placeholder="Select survey language..."
                />
            </xpath>
        </field>
    </record>

</odoo>
