<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- SURVEY LANGUAGE LIST VIEW -->
    <record id="survey_language_tree" model="ir.ui.view">
        <field name="name">survey.language.tree</field>
        <field name="model">survey.language</field>
        <field name="arch" type="xml">
            <tree string="Survey Languages" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- SURVEY LANGUAGE FORM VIEW -->
    <record id="survey_language_form" model="ir.ui.view">
        <field name="name">survey.language.form</field>
        <field name="model">survey.language</field>
        <field name="arch" type="xml">
            <form string="Survey Language">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SURVEY LANGUAGE ACTION -->
    <record id="action_survey_language" model="ir.actions.act_window">
        <field name="name">Survey Languages</field>
        <field name="res_model">survey.language</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new survey language
            </p>
            <p>
                Survey languages are used to show the correct images when printing surveys.
            </p>
        </field>
    </record>

    <!-- CONFIGURATION MENU -->
    <menuitem
        name="Configuration"
        id="menu_survey_configuration"
        parent="survey.menu_surveys"
        sequence="100"
        groups="base.group_system"
    />

    <!-- MENU ITEM -->
    <menuitem
        name="Survey Languages"
        id="menu_survey_language"
        action="action_survey_language"
        parent="survey_question_multiple_image_support.menu_survey_configuration"
        sequence="10"
    />

</odoo>
