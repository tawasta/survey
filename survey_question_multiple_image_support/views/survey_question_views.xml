<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="survey_question_form_inherit_image_lang" model="ir.ui.view">
        <field name="name">survey.question.form.inherit.image.lang</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form" />
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page name="image_language_settings" string="Image Settings">

                    <group>

                        <field name="question_image_ids">

                            <tree editable="bottom">
                                <field
                                    name="image_lang_id"
                                    options="{'no_create': True}"
                                />

                                <field
                                    name="question_image"
                                    widget="image"
                                    class="oe_avatar"
                                />
                            </tree>

                            <form string="Question Image">
                                <group>
                                    <field
                                        name="image_lang_id"
                                        options="{'no_create': True}"
                                    />

                                    <field
                                        name="question_image"
                                        widget="image"
                                        class="oe_avatar"
                                    />
                                </group>
                            </form>

                        </field>

                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>
