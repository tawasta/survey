<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="survey_page_print_inherit_image"
        inherit_id="survey.survey_page_print"
        name="Survey print: add language images"
    >
        <xpath
            expr="//t[@t-foreach='survey.question_and_page_ids']/t[@t-if='not question.is_page and not answer or (question in answer.predefined_question_ids &amp; questions_to_display)']/div[@class='js_question-wrapper']/h2"
            position="after"
        >
            <t t-foreach="question.question_image_ids" t-as="img">
                <t t-if="img.image_lang_id.code == survey_lang_code">
                    <div style="margin-top:10px;">
                        <img
                            t-att-src="'data:image/png;base64,%s' % img.question_image.decode('utf-8')"
                            style="max-width:400px; max-height:400px;"
                        />
                    </div>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
