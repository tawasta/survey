<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="survey_question_form_save_zip">
        <field name="name">survey.question.form.save.zip</field>
        <field name="model">survey.question</field>
        <field
            name="inherit_id"
            ref="survey_contact_ids_save_city.survey_question_form_save_city"
        />
        <field name="arch" type="xml">
            <field name="contact_number" position="attributes">
                <attribute
                    name="invisible"
                >not save_as_contact_name and not save_as_contact_phone and not save_as_contact_email and not save_as_contact_city and not save_as_contact_zip</attribute>
                <attribute
                    name="required"
                >save_as_contact_name or save_as_contact_phone or save_as_contact_email or save_as_contact_city or save_as_contact_zip</attribute>
            </field>
            <field name="save_as_contact_city" position="after">
                <field name="save_as_partner_zip" />
                <field name="save_as_contact_zip" />
            </field>
        </field>
    </record>
</odoo>
