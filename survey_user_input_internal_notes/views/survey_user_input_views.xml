<odoo>
    <record id="survey_user_input_view_form_inherit" model="ir.ui.view">
        <field name="name">survey.user_input.form.inherit.internal.notes</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Internal Notes" name="page_internal_notes">

                    <field name="internal_notes" placeholder="Internal notes..." />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
