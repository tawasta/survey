<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="survey_question_form_contact">
        <field name="name">survey.question.form.contact</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form" />
        <field name="arch" type="xml">
            <field name="validation_email" position="before">
                <field
                    name="contact_number"
                    nolabel="1"
                    invisible="not save_as_contact_name and not save_as_contact_phone and not save_as_contact_email"
                    required="save_as_contact_name or save_as_contact_phone or save_as_contact_email"/>
            </field>
            <field name="save_as_nickname" position="after">
                <field name="save_as_contact_name" />
                <field name="save_as_contact_phone"  />
            </field>
            <field name="save_as_email" position="after">
                <field
                    name="save_as_contact_email"
                    invisible="not validation_email"/>
            </field>
        </field>
    </record>
</odoo>
