<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="survey_question_form_save_as_company">
        <field name="name">Form view for survey question save as company</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form" />
        <field name="arch" type="xml">
            <field name="save_as_nickname" position="after">
                <field name="save_as_company_name" />

                <field name="save_as_company_street" />

                <field name="save_as_company_zip" />

                <field name="save_as_company_city" />

                <field name="save_as_company_website" />
            </field>
        </field>
    </record>
</odoo>
