<odoo>

    <record id="survey_user_input_view_search" model="ir.ui.view">
        <field
            name="name"
        >survey.user_input.search.inherit.funding.application.base</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_search" />
        <field name="arch" type="xml">
            <field name="email" position="before">
                <field name="user_id" />
            </field>

            <filter name="group_by_email" position="before">
                <filter
                    string="Responsible"
                    name="group_by_user_id"
                    domain="[]"
                    context="{'group_by': 'user_id'}"
                />
                <filter
                    string="Funding Decision Date"
                    name="group_by_funding_decision_date"
                    domain="[]"
                    context="{'group_by': 'funding_decision_date'}"
                />
            </filter>
        </field>
    </record>


    <record id="survey_user_input_view_tree" model="ir.ui.view">
        <field
            name="name"
        >survey.user_input.tree.inherit.funding.application.base</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_tree" />
        <field name="arch" type="xml">

            <field name="survey_id" position="before">
                <field name="service_identifier" optional="show" />
                <field name="user_id" optional="show" />
                <field name="funding_decision_date" optional="show" />
                <field
                    name="funding_decision_amount"
                    optional="show"
                    widget="monetary"
                    options="{'currency_field': 'funding_decision_currency_id'}"
                    sum="Total (Funding Decision Amount)"
                />
                <field name="funding_decision_currency_id" column_invisible="1" />
                <field name="tax_id" optional="hide" />

                <field
                    name="funding_left_amount"
                    widget="monetary"
                    options="{'currency_field': 'funding_left_currency_id'}"
                    optional="show"
                    decoration-success="funding_left_amount &gt;= 0"
                    decoration-danger="funding_left_amount &lt; 0"
                    sum="Total (Funding Left)"
                />
                <field name="funding_left_currency_id" column_invisible="1" />
                <field name="funding_overspent_date" optional="hide" />

                <field name="date_finished" optional="show" />
                <field name="date_cancelled" optional="hide" />
            </field>

        </field>
    </record>

    <record
        id="survey_user_input_view_form_inherit_survey_payment_link"
        model="ir.ui.view"
    >
        <field
            name="name"
        >survey.user_input.form.survey.funding.application.base.inherit.survey.payment.link</field>
        <field name="model">survey.user_input</field>
        <field
            name="inherit_id"
            ref="survey_payment_link.view_survey_user_input_form_inherit_payments"
        />
        <field name="arch" type="xml">

            <!-- Use the Payments page from survey_payment_link, and add more fields into it -->
            <xpath expr="//page[@name='page_payments']" position="attributes">
                <attribute name="string">Funding Information &amp; Payments</attribute>
            </xpath>

            <group name="group_payments" position="before">
                <group>
                    <group
                        string="Internal Information"
                        name="group_internal_information"
                    >
                        <!-- TODO: can maybe be removed, just utilize the ref field -->
                        <field name="service_identifier" />
                        <field name="user_id" options="{'no_create': True}" />
                        <field name="show_in_registry"/>
                    </group>
                    <group string="Completion Details" name="group_completion_details">
                        <field name="date_finished" />
                        <field name="date_cancelled" />
                    </group>
                </group>

                 <group>
                    <group
                        string="Funding Decision Basic Info"
                        name="group_funding_decision_basic_info"
                    >
                        <field name="funding_decision_date" />
                        <field
                            name="funding_decision_amount"
                            widget="monetary"
                            options="{'currency_field': 'funding_decision_currency_id'}"
                        />
                        <field name="tax_id" options="{'no_create': True}" />
                        <field name="funding_decision_currency_id" invisible="1" />
                        <field name="funding_decision_terms" />
                    </group>
                </group>
            </group>

            <group name="group_payments" position="after">
                <group>
                    <group
                        name="group_under_over_spending"
                        string="Under-/Overspending"
                    >
                        <field
                            name="funding_left_amount"
                            widget="monetary"
                            options="{'currency_field': 'funding_left_currency_id'}"
                            decoration-success="funding_left_amount &gt;= 0"
                            decoration-danger="funding_left_amount &lt; 0"
                        />
                        <field name="funding_left_currency_id" invisible="1" />
                        <field name="funding_overspent_date" />
                    </group>
                </group>
            </group>
        </field>
    </record>

    <record id="survey_user_input_view_form_registry" model="ir.ui.view">
        <field
            name="name"
        >survey.user_input.tree.inherit.registry.base</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey_registry_portal.survey_user_input_view_form" />
        <field name="arch" type="xml">

            <!-- 1) Piilota survey_registry_portal-moduulin lisäämä välilehti -->
            <xpath expr="//page[@name='page_survey_registry']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>
</odoo>
