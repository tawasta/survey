<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="survey_page_print_qr_code"
        inherit_id="survey.survey_page_print"
        name="Survey print: add QR code header"
    >
        <xpath
            expr="//div[@class='o_survey_print container']/div[@class='py-5 mt32']"
            position="before"
        >
            <div t-if="survey.qr_code" style="margin-bottom: 20px;">
                <img
                    t-att-src="'data:image/png;base64,%s' % survey.qr_code.decode('utf-8')"
                    style="max-width:150px; max-height:150px;"
                />
            </div>
        </xpath>
    </template>
</odoo>
