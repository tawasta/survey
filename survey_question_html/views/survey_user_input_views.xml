<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="survey_user_input_line_html_view_form" model="ir.ui.view">
        <field name="name">survey.user_input.line.html.view.form</field>
        <field name="model">survey.user_input.line</field>
        <field name="inherit_id" ref="survey.survey_user_input_line_view_form"/>
        <field name="arch" type="xml">
            <field name="suggested_answer_id" position="after">
                <field name="answer_type" invisible="1"/>
                <field name="value_html" widget="html" options="{'style-inline': True}" invisible="answer_type != 'html'"/>
            </field>
        </field>
    </record>
</odoo>
