<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="survey_user_input_view_form" model="ir.ui.view">
        <field name="name">survey.user_input.view.form.registry</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Survey Registry" name="page_survey_registry">
                    <group string="Visibility" name="group_survey_registry_visibility">
                        <field name="show_in_registry" />
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
