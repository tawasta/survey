<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template
        id="portal_breadcrumbs"
        name="Survey registry breadcrumbs"
        inherit_id="portal.portal_breadcrumbs"
        priority="100"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'survey_registry'"
                t-attf-class="breadcrumb-item #{'active ' if not input else ''}"
            >
                <a
                    t-if="input"
                    t-attf-href="/surveys/registry?{{ keep_query() }}"
                >Survey Registry</a>
                <t t-else="">Survey Registry</t>
            </li>
            <li t-if="input" class="breadcrumb-item active">
                <t t-esc="input.title_in_survey_registry" />
            </li>
        </xpath>
        <xpath expr="//li[a[@href='/my/home']]/a" position="replace">
            <a
                t-attf-href="{{ '/' if page_name == 'survey_registry' else '/my/home' }}"
                aria-label="Home"
                title="Home"
            >
                <i class="fa fa-home" />
            </a>
        </xpath>

    </template>



    <template id="survey_registry_page" name="Survey Registry Page">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Survey Registry</t>
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <section class="container">
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">
                        <h2 class="fw-bold mb-4">Survey Registry</h2>
                    </t>
                </t>

                <t t-if="not inputs">
                    <div
                        class="alert alert-warning shadow-sm rounded text-center py-4"
                        role="alert"
                    >
                        <i class="fa fa-info-circle me-2 text-muted" />
                        <t t-if="search">
                            No matches found.
                        </t>
                        <t t-else="">
                            Survey registry does not have any content yet.
                        </t>
                    </div>
                </t>

                <t t-if="inputs">
                    <div class="table-responsive shadow-sm rounded overflow-hidden">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="th-title">Title</th>
                                    <th class="th-partner">Partner</th>
                                    <th class="th-date">Date</th>
                                    <th class="th-survey">Survey</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="inputs" t-as="input">
                                    <tr>

                                        <td class="td-title">
                                            <a
                                                t-attf-href="/surveys/registry/{{ input.id }}"
                                            >
                                                <t
                                                    t-out="input.title_in_survey_registry or '-'"
                                                />
                                            </a>
                                        </td>

                                        <td class="td-partner">
                                            <t t-out="input.partner_id.name or '-'" />
                                        </td>
                                        <td class="td-date">
                                            <span
                                                t-field="input.create_date"
                                                t-options="{'widget': 'date'}"
                                            />
                                        </td>

                                        <td>
                                            <t t-out="input.survey_id.title" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div
                        t-if="pager"
                        class="o_portal_pager d-flex justify-content-center"
                    >
                        <t t-call="website.pager">
                            <t t-set="pager" t-value="pager" />
                        </t>
                    </div>
                </t>
            </section>
        </t>
    </template>


    <template
        id="survey_registry_single_user_input_field"
        name="Survey Registry: Single User Input Field"
    >
        <t t-set="field_name" t-value="survey_registry_field_line.field_id.name" />
        <t t-set="field_type" t-value="survey_registry_field_line.field_id.ttype" />
        <t
            t-set="field_value"
            t-value="input[survey_registry_field_line.field_id.name]"
        />


        <strong><t t-esc="survey_registry_field_line.title_on_website" /></strong>:

        <t t-if="field_type == 'selection'">
            <t
                t-set="selection_dict"
                t-value="dict(input.fields_get()[field_name]['selection'])"
            />
            <t t-set="human_readable_selection_value" t-value="input[field_name]" />
            <t t-esc="selection_dict.get(human_readable_selection_value)" />
        </t>
        <t t-if="field_type == 'float'">

            <!-- trim e.g. 5000.0 to 5000 so that the shown monetary amounts look nicer.
             TODO: if floats with decimals get actually used in survey registry,
             this will need a better solution  -->
            <t
                t-esc="int(field_value) if field_value == int(field_value) else field_value"
            />

        </t>
        <t t-if="field_type == 'many2one'">
            <t t-esc="input[survey_registry_field_line.field_id.name].name" />
        </t>
        <t t-if="field_type not in ['selection', 'float', 'many2one']">
             <t t-esc="input[survey_registry_field_line.field_id.name]" />
        </t>

        <t t-esc="survey_registry_field_line.value_suffix_on_website" />
        <br />


    </template>

    <template id="survey_registry_detail" name="Survey Registry Detail">
        <t t-call="portal.portal_layout">

            <section class="container my-5">

                <div class="card">
                    <div class="card-body">


                        <div class="mb-4">
                            <h3 class="text-muted"><t
                                    t-out="input.title_in_survey_registry"
                                /></h3>
                        </div>

                        <t t-if="len(input.survey_id.survey_registry_field_line_ids)">

                                <t
                                t-foreach="input.survey_id.survey_registry_field_line_ids"
                                t-as="survey_registry_field_line"
                            >
                                        <t
                                    t-call="survey_registry_portal.survey_registry_single_user_input_field"
                                />
                                </t>

                        </t>

                        <h4
                            class="title-applicants-info mt-4"
                        >Information provided by the applicant</h4>

                        <!-- mobile friendly table, collapses on smaller screens -->
                        <table
                            class="table table-striped table-hover table-sm"
                            style="table-layout: fixed; width: 100%;"
                        >
                            <tbody>
                                <t
                                    t-foreach="input.user_input_line_ids.filtered(lambda l: l.question_id.show_answer_in_survey_registry)"
                                    t-as="user_input_line"
                                >
                                    <tr class="d-block d-md-table-row">

                                        <td
                                            class="fw-bold d-block d-md-table-cell w-100 w-md-50"
                                        >
                                            <span>
                                                <t
                                                    t-out="user_input_line.question_id.title"
                                                />
                                            </span>
                                        </td>

                                        <!-- Render answer according to question type. TODO: handle rest of types-->
                                        <td
                                            class="d-block d-md-table-cell w-100 w-md-50"
                                        >
                                            <t
                                                t-if="user_input_line.answer_type == 'char_box'"
                                                t-out="user_input_line.value_char_box"
                                            />
                                            <t
                                                t-if="user_input_line.answer_type == 'numerical_box'"
                                                t-out="user_input_line.value_numerical_box"
                                            />
                                            <t
                                                t-if="user_input_line.answer_type == 'text_box'"
                                                t-out="user_input_line.value_text_box"
                                            />
                                            <t
                                                t-if="user_input_line.answer_type == 'suggestion'"
                                                t-out="user_input_line.suggested_answer_id.value"
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

        </t>
    </template>

</odoo>
